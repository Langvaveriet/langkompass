generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  name                      String                     @default("LångKompass Benutzer")
  emailVerified             Boolean                    @default(false)
  image                     String?
  healthProfile             HealthProfile?
  settings                  UserSettings?
  dailyEntries              DailyEntry[]
  measurements              BodyMeasurement[]
  exercises                 Exercise[]
  trainingPlans             TrainingPlan[]
  trainingPlanExercises     TrainingPlanExercise[]
  trainingSessions          TrainingSession[]
  trainingSets              TrainingSet[]
  recipes                   Recipe[]
  recipeItems               RecipeItem[]
  mealPlanEntries           MealPlanEntry[]
  shoppingListItemStates    ShoppingListItemState[]
  labReports                LabReport[]
  labResults                LabResult[]
  labResultRevisions        LabResultRevision[]
  labReferenceRanges        LabReferenceRange[]
  supplements               Supplement[]
  supplementIngredients     SupplementIngredient[]
  supplementIntakes         SupplementIntake[]
  supplementIntakeRevisions SupplementIntakeRevision[]
  sessions                  Session[]
  accounts                  Account[]
  passkeys                  Passkey[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  timeZone  String   @default("Europe/Stockholm")
  locale    String   @default("de-DE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
}

model HealthProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  firstName                String?
  lastName                 String?
  dateOfBirth              DateTime?
  heightCm                 Int?
  weightKg                 Decimal?           @db.Decimal(5, 2)
  calorieFormulaSex        CalorieFormulaSex?
  activityLevel            ActivityLevel?
  weightGoal               WeightGoal?
  manualDailyCalorieTarget Int?
  primaryGoal              String?
  activityGoal             String?
  preferredDietaryPatterns DietaryPattern[]   @default([])
  excludedFoodCategories   FoodCategory[]     @default([])
  avoidHistamine           Boolean            @default(false)
  maxRecipePrepMinutes     Int?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CalorieFormulaSex {
  FEMALE
  MALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
  VERY_HIGH
}

enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

enum DailyEntryStatus {
  OPEN
  MORNING_DONE
  COMPLETED
}

enum MeasurementType {
  WEIGHT
  WAIST_CIRCUMFERENCE
}

enum MeasurementUnit {
  KILOGRAM
  CENTIMETER
}

enum EntrySource {
  MANUAL
}

enum FastingStatus {
  UNKNOWN
  FASTING
  NOT_FASTING
}

enum LabCorrectionReason {
  ENTRY_ERROR
  REPORT_CORRECTION
  REFERENCE_UPDATE
  OTHER
}

enum SupplementForm {
  CAPSULE
  TABLET
  POWDER
  LIQUID
  DROPS
  SPRAY
  OTHER
}

enum SupplementDoseUnit {
  CAPSULE
  TABLET
  GRAM
  MILLIGRAM
  MILLILITER
  DROP
  SCOOP
  SPRAY
}

enum SupplementIngredientUnit {
  GRAM
  MILLIGRAM
  MICROGRAM
  INTERNATIONAL_UNIT
}

enum SupplementReason {
  GENERAL_WELLBEING
  DEFICIENCY
  LAB_SUPPORT
  IMMUNE_SUPPORT
  DIGESTION
  SLEEP
  ENERGY
  TRAINING
  OTHER
}

enum SupplementTolerance {
  NOT_RATED
  WELL_TOLERATED
  NEUTRAL
  POSSIBLE_REACTION
}

enum SupplementEffect {
  NOT_RATED
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNCLEAR
}

enum SupplementIntakeCorrectionReason {
  ENTRY_ERROR
  TIME_CORRECTION
  DOSE_CORRECTION
  OBSERVATION_UPDATE
  OTHER
}

enum ExerciseCategory {
  STRENGTH
  MOBILITY
  CARDIO
  BALANCE
}

enum ExerciseEquipment {
  BODYWEIGHT
  DUMBBELL
  BARBELL
  KETTLEBELL
  MACHINE
  CABLE
  RESISTANCE_BAND
  CARDIO_MACHINE
  OTHER
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  CORE
  GLUTES
  LEGS
  FULL_BODY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DRINK
}

enum RecipeOrigin {
  USER
  CURATED
}

enum DietaryPattern {
  MEDITERRANEAN
  KETOGENIC
  VEGETARIAN
}

enum FoodCategory {
  VEGETABLE
  FRUIT
  GRAIN
  LEGUME
  NUT_SEED
  DAIRY
  EGG
  MEAT
  FISH_SEAFOOD
  FAT_OIL
  SWEET
  BEVERAGE
  CONDIMENT
  PREPARED_MEAL
  OTHER
}

enum PortionSize {
  SMALL
  MEDIUM
  LARGE
}

enum QuantityUnit {
  GRAM
  MILLILITER
  PIECE
  PORTION
  TABLESPOON
  TEASPOON
  CUP
}

enum FoodTrait {
  HISTAMINE_RICH
  HISTAMINE_LIBERATOR
  ALCOHOLIC
  HIGH_SUGAR
  HIGHLY_PROCESSED
  FERMENTED
  CAFFEINATED
}

model DailyEntry {
  id            String           @id @default(cuid())
  userId        String
  entryDate     DateTime         @db.Date
  status        DailyEntryStatus @default(OPEN)
  wellbeing     Int?
  mood          Int?
  energy        Int?
  sleepHours    Decimal?         @db.Decimal(4, 2)
  sleepQuality  Int?
  hungerLevel   Int?
  painLevel     Int?
  stressLevel   Int?
  waterLiters   Decimal?         @db.Decimal(5, 2)
  steps         Int?
  distanceKm    Decimal?         @db.Decimal(7, 2)
  activeMinutes Int?
  symptoms      String?
  symptomTags   String[]         @default([])
  activityTags  String[]         @default([])
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals        Meal[]
  measurements BodyMeasurement[]

  @@unique([userId, entryDate])
  @@index([userId, entryDate])
}

model BodyMeasurement {
  id           String          @id @default(cuid())
  userId       String
  dailyEntryId String
  type         MeasurementType
  value        Decimal         @db.Decimal(8, 2)
  unit         MeasurementUnit
  measuredAt   DateTime
  source       EntrySource     @default(MANUAL)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyEntry DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@unique([dailyEntryId, type])
  @@index([userId, type, measuredAt])
}

model LabReport {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String
  collectedAt      DateTime
  fastingStatus    FastingStatus @default(UNKNOWN)
  laboratory       String?
  physicianComment String?
  controlDate      DateTime?     @db.Date
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  results LabResult[]

  @@index([userId, collectedAt])
}

model LabResult {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String
  labReportId   String      @db.Uuid
  analyteKey    String
  analyteName   String
  value         Decimal     @db.Decimal(14, 4)
  unit          String
  referenceLow  Decimal?    @db.Decimal(14, 4)
  referenceHigh Decimal?    @db.Decimal(14, 4)
  measuredAt    DateTime
  source        EntrySource @default(MANUAL)
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  labReport LabReport           @relation(fields: [labReportId], references: [id], onDelete: Cascade)
  revisions LabResultRevision[]

  @@unique([labReportId, analyteKey])
  @@index([userId, analyteKey, measuredAt])
  @@index([labReportId])
}

model LabResultRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String
  labResultId           String              @db.Uuid
  previousValue         Decimal             @db.Decimal(14, 4)
  previousReferenceLow  Decimal?            @db.Decimal(14, 4)
  previousReferenceHigh Decimal?            @db.Decimal(14, 4)
  previousNote          String?
  reason                LabCorrectionReason
  correctedAt           DateTime            @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labResult LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)

  @@index([userId, correctedAt])
  @@index([labResultId, correctedAt])
}

model LabReferenceRange {
  id            String   @id @default(cuid())
  userId        String
  analyteKey    String
  unit          String
  referenceLow  Decimal? @db.Decimal(14, 4)
  referenceHigh Decimal? @db.Decimal(14, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, analyteKey])
  @@index([userId, analyteKey])
}

model Supplement {
  id          String             @id @default(cuid())
  userId      String
  name        String
  brand       String?
  form        SupplementForm
  defaultDose Decimal            @db.Decimal(8, 2)
  doseUnit    SupplementDoseUnit
  reason      SupplementReason
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients SupplementIngredient[]
  intakes     SupplementIntake[]

  @@unique([userId, name])
  @@index([userId, archivedAt, name])
}

model SupplementIngredient {
  id              String                    @id @default(cuid())
  userId          String
  supplementId    String
  name            String
  amount          Decimal?                  @db.Decimal(10, 3)
  elementalAmount Decimal?                  @db.Decimal(10, 3)
  unit            SupplementIngredientUnit?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@unique([supplementId, name])
  @@index([userId, name])
}

model SupplementIntake {
  id           String              @id @default(cuid())
  userId       String
  supplementId String
  takenAt      DateTime
  dose         Decimal             @db.Decimal(8, 2)
  doseUnit     SupplementDoseUnit
  tolerance    SupplementTolerance @default(NOT_RATED)
  effect       SupplementEffect    @default(NOT_RATED)
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplement Supplement                 @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  revisions  SupplementIntakeRevision[]

  @@index([userId, takenAt])
  @@index([supplementId, takenAt])
}

model SupplementIntakeRevision {
  id                 String                           @id @default(cuid())
  userId             String
  supplementIntakeId String
  previousTakenAt    DateTime
  previousDose       Decimal                          @db.Decimal(8, 2)
  previousDoseUnit   SupplementDoseUnit
  previousTolerance  SupplementTolerance
  previousEffect     SupplementEffect
  previousNote       String?
  reason             SupplementIntakeCorrectionReason
  correctedAt        DateTime                         @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  intake SupplementIntake @relation(fields: [supplementIntakeId], references: [id], onDelete: Cascade)

  @@index([userId, correctedAt])
  @@index([supplementIntakeId, correctedAt])
}

model Exercise {
  id             String            @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  category       ExerciseCategory
  equipment      ExerciseEquipment
  muscleGroups   MuscleGroup[]     @default([])
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planExercises TrainingPlanExercise[]
  trainingSets  TrainingSet[]

  @@unique([userId, normalizedName])
  @@index([userId, archivedAt, category])
}

model TrainingPlan {
  id             String    @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises TrainingPlanExercise[]
  sessions  TrainingSession[]

  @@unique([userId, normalizedName])
  @@index([userId, archivedAt])
}

model TrainingPlanExercise {
  id             String   @id @default(cuid())
  userId         String
  trainingPlanId String
  exerciseId     String
  position       Int
  targetSets     Int      @default(3)
  targetReps     Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([trainingPlanId, exerciseId])
  @@index([userId, trainingPlanId])
  @@index([exerciseId])
}

model TrainingSession {
  id             String    @id @default(cuid())
  userId         String
  trainingPlanId String?
  planName       String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  sets         TrainingSet[]

  @@index([userId, startedAt])
  @@index([userId, completedAt])
  @@index([trainingPlanId])
}

model TrainingSet {
  id                String   @id @default(cuid())
  userId            String
  trainingSessionId String
  exerciseId        String
  setNumber         Int
  repetitions       Int
  weightKg          Decimal? @db.Decimal(7, 2)
  effort            Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([trainingSessionId, exerciseId, setNumber])
  @@index([userId, createdAt])
  @@index([exerciseId, createdAt])
}

model Meal {
  id                   String   @id @default(cuid())
  dailyEntryId         String
  type                 MealType
  consumedAt           DateTime
  notes                String?
  postMealSymptomTags  String[] @default([])
  reactionDelayMinutes Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  dailyEntry DailyEntry     @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  items      MealItem[]
  planEntry  MealPlanEntry?

  @@index([dailyEntryId, consumedAt])
}

model MealItem {
  id         String        @id @default(cuid())
  mealId     String
  foodKey    String?
  name       String
  category   FoodCategory
  portion    PortionSize   @default(MEDIUM)
  quantity   Decimal?      @db.Decimal(7, 2)
  unit       QuantityUnit?
  energyKcal Decimal?      @db.Decimal(7, 2)
  traits     FoodTrait[]   @default([])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([foodKey])
  @@index([category])
}

model Recipe {
  id                String           @id @default(cuid())
  userId            String
  name              String
  normalizedName    String
  type              MealType
  origin            RecipeOrigin     @default(USER)
  description       String?
  prepMinutes       Int?
  servings          Int?
  instructions      String?
  carbohydrateGrams Decimal?         @db.Decimal(7, 2)
  proteinGrams      Decimal?         @db.Decimal(7, 2)
  fatGrams          Decimal?         @db.Decimal(7, 2)
  dietaryPatterns   DietaryPattern[] @default([])
  sourceLabel       String?
  sourceUrl         String?
  favoriteAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       RecipeItem[]
  planEntries MealPlanEntry[]

  @@unique([userId, normalizedName])
  @@index([userId, favoriteAt, updatedAt])
  @@index([userId, archivedAt, updatedAt])
}

model RecipeItem {
  id         String        @id @default(cuid())
  userId     String
  recipeId   String
  position   Int
  foodKey    String?
  name       String
  category   FoodCategory
  portion    PortionSize   @default(MEDIUM)
  quantity   Decimal?      @db.Decimal(7, 2)
  unit       QuantityUnit?
  energyKcal Decimal?      @db.Decimal(7, 2)
  traits     FoodTrait[]   @default([])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
  @@index([userId, recipeId])
  @@index([foodKey])
  @@index([category])
}

model CatalogRecipe {
  key               String           @id
  name              String
  emoji             String
  type              MealType
  description       String
  prepMinutes       Int
  servings          Int
  carbohydrateGrams Decimal          @db.Decimal(7, 2)
  proteinGrams      Decimal          @db.Decimal(7, 2)
  fatGrams          Decimal          @db.Decimal(7, 2)
  dietaryPatterns   DietaryPattern[] @default([])
  instructions      String
  sourceLabel       String?
  sourceUrl         String?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items CatalogRecipeItem[]

  @@index([active, type, name])
}

model CatalogRecipeItem {
  id               String       @id @default(cuid())
  catalogRecipeKey String
  position         Int
  foodKey          String?
  name             String
  category         FoodCategory
  quantity         Decimal      @db.Decimal(7, 2)
  unit             QuantityUnit
  energyKcal       Decimal      @db.Decimal(7, 2)
  traits           FoodTrait[]  @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  catalogRecipe CatalogRecipe @relation(fields: [catalogRecipeKey], references: [key], onDelete: Cascade)

  @@unique([catalogRecipeKey, position])
  @@index([foodKey])
  @@index([category])
}

model MealPlanEntry {
  id          String    @id @default(cuid())
  userId      String
  recipeId    String
  mealId      String?   @unique
  plannedDate DateTime  @db.Date
  type        MealType
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  meal   Meal?  @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@unique([userId, plannedDate, type])
  @@index([userId, plannedDate])
  @@index([recipeId])
}

model ShoppingListItemState {
  id        String    @id @default(cuid())
  userId    String
  weekStart DateTime  @db.Date
  itemKey   String
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, itemKey])
  @@index([userId, weekStart])
}
